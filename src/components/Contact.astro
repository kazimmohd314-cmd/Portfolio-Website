---
---

<section id="contact" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-8 sm:py-24">
  <!-- Section Title Strip -->
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-6 hairline-b mb-12">
    <div>
      <span class="font-mono text-xs uppercase tracking-widest text-[var(--accent)] font-bold">
        04 // INQUIRIES
      </span>
      <h2 class="font-display font-extrabold text-3xl sm:text-5xl text-[var(--ink)] tracking-tight mt-1">
        LET'S CONNECT
      </h2>
    </div>
    <div class="font-mono text-xs text-[var(--muted)]">
      <span>[DIRECT DISPATCH]</span>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Main Email Area -->
    <div class="lg:col-span-8 hairline p-6 sm:p-12 bg-[var(--card-bg)]">
      <p class="font-mono text-xs uppercase tracking-wider text-[var(--muted)] mb-4">
        DIRECT CONTACT / INBOX
      </p>

      <!-- Big Typographic Email Link -->
      <a
        href="mailto:kazimmohd314@gmail.com"
        class="inline-block font-display font-extrabold text-2xl sm:text-4xl lg:text-5xl text-[var(--ink)] hover:text-[var(--accent)] tracking-tight break-all transition-colors mb-6"
        aria-label="Send email to kazimmohd314@gmail.com"
      >
        kazimmohd314@gmail.com
      </a>

      <!-- Max 2 short sentences per copy rule -->
      <p class="text-base text-[var(--muted)] leading-relaxed mb-8 max-w-xl">
        Currently interviewing for technical internships and software development opportunities. Every thoughtful message receives a prompt response.
      </p>

      <div class="flex flex-wrap items-center gap-4">
        <a
          href="mailto:kazimmohd314@gmail.com"
          class="touch-target px-6 py-3 bg-[var(--accent)] text-white font-mono text-xs uppercase font-bold tracking-wider hover:bg-[var(--ink)] transition-colors"
        >
          <span>Initiate Email ↗</span>
        </a>

        <a
          href="https://mail.google.com/mail/?view=cm&fs=1&to=kazimmohd314@gmail.com"
          target="_blank"
          rel="noopener noreferrer"
          class="touch-target px-6 py-3 hairline bg-[var(--paper)] text-[var(--ink)] font-mono text-xs uppercase tracking-wider hover:bg-[var(--card-bg)] transition-colors"
        >
          <span>Open in Gmail ↗</span>
        </a>
      </div>
    </div>

    <!-- Social / Network Channels -->
    <div class="lg:col-span-4 flex flex-col gap-4">
      <!-- LinkedIn Card -->
      <a
        href="https://linkedin.com/in/mohd-kazim-47a209301"
        target="_blank"
        rel="noopener noreferrer"
        class="touch-target hairline p-6 bg-[var(--card-bg)] hover:border-[var(--accent)] transition-colors flex items-center justify-between group"
        aria-label="Visit Mohd Kazim's LinkedIn profile"
      >
        <div>
          <span class="block font-mono text-xs text-[var(--muted)] uppercase">Professional Network</span>
          <span class="font-display font-bold text-xl text-[var(--ink)] group-hover:text-[var(--accent)] transition-colors">
            LinkedIn Profile
          </span>
        </div>
        <span class="font-mono text-lg text-[var(--muted)] group-hover:text-[var(--accent)] group-hover:translate-x-1 transition-all">
          ↗
        </span>
      </a>

      <!-- GitHub Card -->
      <a
        href="https://github.com/kazimmohd314-cmd"
        target="_blank"
        rel="noopener noreferrer"
        class="touch-target hairline p-6 bg-[var(--card-bg)] hover:border-[var(--accent)] transition-colors flex items-center justify-between group"
        aria-label="Visit Mohd Kazim's GitHub repository profile"
      >
        <div>
          <span class="block font-mono text-xs text-[var(--muted)] uppercase">Source Repositories</span>
          <span class="font-display font-bold text-xl text-[var(--ink)] group-hover:text-[var(--accent)] transition-colors">
            GitHub Profile
          </span>
        </div>
        <span class="font-mono text-lg text-[var(--muted)] group-hover:text-[var(--accent)] group-hover:translate-x-1 transition-all">
          ↗
        </span>
      </a>

      <!-- Location Card -->
      <div class="hairline p-6 bg-[var(--paper)] font-mono text-xs text-[var(--muted)] space-y-2">
        <div class="flex justify-between">
          <span>TIMEZONE</span>
          <span class="text-[var(--ink)] font-semibold">IST (UTC+5:30)</span>
        </div>
        <div class="flex justify-between">
          <span>BASE</span>
          <span class="text-[var(--ink)] font-semibold">Lucknow, India</span>
        </div>
      </div>
    </div>
  </div>
</section>

