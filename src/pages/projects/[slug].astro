---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id.replace(/\.md$/, '').toLowerCase() },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const pageTitle = `${data.title} — Mohd Kazim`;
const pageDescription = data.summary;

const projectJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": data.title,
  "applicationCategory": "WebApplication",
  "operatingSystem": "All",
  "description": data.summary,
  "url": data.live,
  "author": {
    "@type": "Person",
    "name": "Mohd Kazim",
    "url": "https://mohdkazim.netlify.app"
  }
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  article={true}
  jsonLd={projectJsonLd}
>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 sm:pt-16 pb-20">
    <!-- Breadcrumb & Back Link -->
    <nav aria-label="Breadcrumb" class="pb-6 hairline-b mb-8 flex items-center justify-between font-mono text-xs text-[var(--muted)]">
      <a href="/#projects" class="touch-target group flex items-center gap-2 hover:text-[var(--ink)] transition-colors">
        <span class="text-[var(--accent)] group-hover:-translate-x-1 transition-transform">←</span>
        <span>INDEX / ALL PROJECTS</span>
      </a>
      <span>CASE {String(data.order).padStart(2, '0')} // {data.year}</span>
    </nav>

    <!-- Project Header -->
    <header class="mb-10">
      <h1 class="font-display font-extrabold text-4xl sm:text-6xl text-[var(--ink)] tracking-tight mb-4">
        {data.title}
      </h1>
      <p class="text-xl sm:text-2xl text-[var(--muted)] leading-snug max-w-2xl">
        {data.summary}
      </p>

      <!-- Tags & Actions -->
      <div class="mt-8 pt-6 hairline-t flex flex-wrap items-center justify-between gap-4">
        <div class="flex flex-wrap gap-2" aria-label="Technologies used">
          {data.tags.map((tag) => (
            <span class="font-mono text-xs px-2.5 py-1 hairline bg-[var(--paper)] text-[var(--muted)]">
              {tag}
            </span>
          ))}
        </div>

        <div class="flex items-center gap-3 font-mono text-xs uppercase">
          <a
            href={data.live}
            target="_blank"
            rel="noopener noreferrer"
            class="touch-target px-5 py-2.5 bg-[var(--accent)] text-white font-bold hover:bg-[var(--ink)] transition-colors"
          >
            Launch Live Demo ↗
          </a>
          {data.code && (
            <a
              href={data.code}
              target="_blank"
              rel="noopener noreferrer"
              class="touch-target px-4 py-2.5 hairline hover:bg-[var(--paper)] text-[var(--ink)] transition-colors"
            >
              GitHub Repo ↗
            </a>
          )}
        </div>
      </div>
    </header>

    <!-- Main Cover Media Frame -->
    <div class="hairline p-2 bg-[var(--card-bg)] mb-12">
      <div class="aspect-[16/10] overflow-hidden bg-[var(--paper)]">
        <Image
          src={data.cover}
          alt={`Full application screenshot of ${data.title}`}
          width={1200}
          height={750}
          loading="eager"
          decoding="async"
          class="w-full h-full object-cover"
        />
      </div>
      <div class="mt-2 pt-2 hairline-t flex items-center justify-between font-mono text-[11px] text-[var(--muted)] px-1">
        <span>FIGURE: INTERFACE PREVIEW</span>
        <span class="text-[var(--accent)]">{data.title.toUpperCase()}</span>
      </div>
    </div>

    <!-- Case Study Body Content -->
    <div class="prose prose-neutral max-w-none space-y-6 text-base sm:text-lg text-[var(--ink)] leading-relaxed font-body">
      <Content />
    </div>

    <!-- Postscript Navigation -->
    <footer class="mt-16 pt-8 hairline-t flex items-center justify-between font-mono text-xs">
      <a href="/#projects" class="touch-target text-[var(--muted)] hover:text-[var(--accent)] transition-colors">
        ← Back to Projects Index
      </a>
      <a href="mailto:kazimmohd314@gmail.com" class="touch-target text-[var(--ink)] hover:text-[var(--accent)] transition-colors">
        Discuss this project ↗
      </a>
    </footer>
  </article>
</BaseLayout>
