---
import Marquee from './Marquee.astro';

const footerItems = [
  "MOHD KAZIM", "SOFTWARE DEVELOPER", "LUCKNOW, INDIA", "COMPUTER SCIENCE", "AVAILABLE FOR INTERNSHIPS", "ASTRO V5", "TAILWIND CSS", "ENGINEERED WITH RIGOR"
];
---

<footer class="w-full bg-[var(--paper)] hairline-t mt-4 sm:mt-16">
  <!-- Reverse Marquee at footer -->
  <Marquee items={footerItems} reverse={true} />

  <!-- Colophon & System Details -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5 sm:py-10">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 sm:gap-6 pb-4 sm:pb-6 hairline-b">
      <div>
        <span class="font-display font-extrabold text-lg sm:text-xl text-[var(--ink)] uppercase tracking-tight">
          Mohd Kazim
        </span>
        <p class="font-mono text-xs text-[var(--muted)] mt-0.5">
          Computer Science Undergraduate • Lucknow, Uttar Pradesh, India
        </p>
      </div>

      <!-- Back to top button -->
      <a
        href="#hero"
        class="touch-target group flex items-center gap-2 font-mono text-xs uppercase text-[var(--muted)] hover:text-[var(--ink)] hairline px-3.5 py-1.5 transition-colors"
        aria-label="Scroll back to top of page"
      >
        <span>Back to Top</span>
        <span class="text-[var(--accent)] group-hover:-translate-y-0.5 transition-transform">↑</span>
      </a>
    </div>

    <!-- Fine Print Strip -->
    <div class="pt-3.5 sm:pt-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 sm:gap-4 font-mono text-[11px] text-[var(--muted)]">
      <div>
        <span>© {new Date().getFullYear()} Mohd Kazim.</span>
      </div>

      
    </div>
  </div>
</footer>
